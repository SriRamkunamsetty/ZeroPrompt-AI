rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isValidHistoryRecord(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'status', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.type is string && data.type.size() <= 50
        && data.status is string && data.status.size() <= 50
        && (!('fileName' in data) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 256))
        && (!('fileUrl' in data) || data.fileUrl == null || (data.fileUrl is string && data.fileUrl.size() <= 1024))
        && (!('result' in data) || data.result == null || data.result is map);
    }
    
    match /users/{userId}/history/{historyId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(historyId)
        && isValidHistoryRecord(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidHistoryRecord(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'result', 'updatedAt']))
        );
        
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
